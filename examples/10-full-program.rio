# برنامج كامل: حساب درجات فصل
دالة تقدير(درجة):
    إذا درجة >= ٩٠:
        ارجع "ممتاز"
    وإلا إذا درجة >= ٥٠:
        ارجع "ناجح"
    وإلا:
        ارجع "راسب"
درجات = {"محمود": ٨٥، "سارة": ٩٢، "علي": ٤٠}
لكل اسم في درجات:
    اطبع اسم + ": " + تقدير(درجات[اسم])
اطبع "المتوسط:"
اطبع مجموع(درجات.values()) / طول(درجات)
اطبع "أعلى درجة:"
اطبع أقصى(درجات.values())
