واجهة قابل_للطباعة:
    دالة اطبع_نفسك():
        مرر
فئة شخص:
    دالة أنشئ(اسم):
        نفس.اسم = اسم
    دالة عرّف():
        ارجع نفس.اسم
    دالة اطبع_نفسك():
        اطبع نفس.اسم
فئة طالب ورث شخص واجهة قابل_للطباعة:
    دالة ادرس():
        ارجع "يدرس"
    دالة عرّف():
        ارجع "طالب: " + نفس.اسم
ط = أنشئ طالب("محمود")
اطبع ط.عرّف()
اطبع ط.ادرس()
ط.اطبع_نفسك()
