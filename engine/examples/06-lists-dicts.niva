# القوائم والقواميس والدوال المدمجة
قائمة = [١، ٢، ٣]
اطبع قائمة[٠]
اطبع طول(قائمة)
اطبع مجموع(قائمة)
اطبع أقصى(قائمة)
قائمة[١] = ٩٩
اطبع قائمة
قاموس = {"اسم": "محمود"، "عمر": ٢٣}
اطبع قاموس["اسم"]
اطبع قاموس["عمر"]
قاموس["مدينة"] = "القاهرة"
اطبع طول(قاموس)
لكل مفتاح في ["اسم"، "عمر"، "مدينة"]:
    اطبع مفتاح
اطبع "محمود" في ["محمود"، "سارة"]
اطبع ٩٩ في قائمة
