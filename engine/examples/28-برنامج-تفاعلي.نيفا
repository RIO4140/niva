# مثال 28 — برنامج تفاعلي بالحوار (مجموعة العرض، المهمة 30):
# يسأل المستخدم ويتفاعل مع إجاباته.
اطبع "ما اسمك؟"
اسم = ادخل()
اطبع "أهلا " + اسم
اطبع "ما لونك المفضل؟"
لون = ادخل()
اطبع "لون جميل: " + لون
اطبع "في أي مدينة تعيش؟"
مدينة = ادخل()
اطبع "تحية من " + مدينة + " إلى " + اسم
اطبع "اسمك فيه " + نص(اسم.طول()) + " أحرف"
اطبع "كم عمرك؟"
عمر = ادخل()
بعد = عدد(عمر) + ١٠
اطبع "بعد عشر سنوات يصير عمرك " + نص(بعد)
اطبع "هل تريد سؤالا أخيرا؟ اكتب نعم أو لا"
جواب = ادخل()
إذا جواب == "نعم":
    اطبع "ما هوايتك؟"
    هواية = ادخل()
    اطبع "هواية جميلة: " + هواية
وإلا:
    اطبع "شكرا على الحوار"
اطبع "انتهى الحوار"
