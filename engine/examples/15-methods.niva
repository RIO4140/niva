# مثال 15: دوال النصوص والقوائم
# النصوص ترجع نصوصا جديدة، والقوائم أضف/أزل
# تعدلان المتغير نفسه (كتابة رجعية).
اطبع "مرحبا".طول()
اطبع "Hello".كبير()
اطبع "Hello".صغير()
اطبع "  محمود  ".قص()
اطبع "أهلا محمود".استبدل("محمود"، "سارة")
اطبع "أ، ب، ج".قسم("، ")
اطبع "مرحبا".يحتوي("رحب")
ق = [1، 2، 3]
اطبع ق.طول()
ق.أضف(4)
اطبع ق
اطبع ق.أزل()
اطبع ق
