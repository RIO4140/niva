# برنامج كامل: حساب درجات فصل
دالة تقدير(درجة):
    إذا درجة >= ٩٠:
        ارجع "ممتاز"
    وإلا إذا درجة >= ٥٠:
        ارجع "ناجح"
    وإلا:
        ارجع "راسب"
درجات = {"محمود": ٨٥، "سارة": ٩٢، "علي": ٤٠}
لكل اسم في ["محمود"، "سارة"، "علي"]:
    اطبع اسم + ": " + تقدير(درجات[اسم])
اطبع "المتوسط:"
اطبع مجموع([٨٥، ٩٢، ٤٠]) / طول([٨٥، ٩٢، ٤٠])
اطبع "أعلى درجة:"
اطبع أقصى([٨٥، ٩٢، ٤٠])
مجموع_الدرجات = ٠
لكل درجة في [٨٥، ٩٢، ٤٠]:
    مجموع_الدرجات = مجموع_الدرجات + درجة
اطبع "مجموع من الحلقة:"
اطبع مجموع_الدرجات
