# مثال 20: خادم HTTPS يتحدث HTTP/2 وHTTP/1.1 معا
# شغّله بـ: نيفا --اسمح-بالخادم 20-خادم-حديث.نيفا
# ثم جرّب من الطرفية:
#   curl --http2 -k https://127.0.0.1:8443/       (يتفاوض HTTP/2)
#   curl --http2 -k https://127.0.0.1:8443/ping   (رد قاموس: حالة 200)
#   curl --http1.1 -k https://127.0.0.1:8443/     (يبقى HTTP/1.1)
# أو من نيفا نفسها (بعلم --اسمح-بالشبكة):
#   اجلب "https://127.0.0.1:8443/ping"  (يتفاوض HTTP/2 تلقائيا)
# التفاوض بـ ALPN: العميل يعرض [h2, http/1.1] والخادم
# يختار؛ بلا واجهة جديدة ولا علم جديد — نفس اخدم.
# الشهادة والمفتاح بجانبه (نفس شهادتي مثال 19).
# للإيقاف: Ctrl+C.
استورد شبكة
دالة عالج(طلب):
    إذا طلب["مسار"] == "/ping":
        ارجع {"حالة": ٢٠٠، "نص": "خادم نيفا يعمل"}
    ارجع "أهلا من خادم نيفا عبر HTTP/2"
شبكة.اخدم 8443 "server-cert.pem" "server-key.pem" عالج
