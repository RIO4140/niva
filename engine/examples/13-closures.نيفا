# الـ closures: دالة ترجع دالة ترى بيئتها وتعدلها
دالة اصنع_عداد():
    ع = ٠
    دالة زد():
        ع = ع + ١
        ارجع ع
    ارجع زد
أ = اصنع_عداد()
ب = اصنع_عداد()
اطبع أ()
اطبع أ()
اطبع أ()
اطبع ب()
دالة اصنع_تحية(اسم):
    دالة حي():
        ارجع "أهلا " + اسم
    ارجع حي
ح = اصنع_تحية("محمود")
اطبع ح()
