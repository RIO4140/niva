# مثال 14: الدوال المجهولة (lambdas)
# دالة_مجهولة(س): س + 1 — تعبير واحد، إرجاع ضمني،
# قيمة دالة كاملة تلتقط معجميا كالـ closures.
مضاعف = دالة_مجهولة(س): س * 2
اطبع مضاعف(5)

دالة طبق(د، س):
    ارجع د(س)
اطبع طبق(دالة_مجهولة(س): س * 3، 4)

دالة اصنع_مضاعف(ن):
    ارجع دالة_مجهولة(س): س * ن
مضاعف3 = اصنع_مضاعف(3)
اطبع مضاعف3(4)

س = 10
احصل = دالة_مجهولة(): س
اطبع احصل()

اطبع طبق(دالة_مجهولة(س: عدد): س + 1، 10)

مركب = دالة_مجهولة(س): دالة_مجهولة(ص): س + ص
اطبع مركب(3)(4)
