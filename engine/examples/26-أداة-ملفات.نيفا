# مثال 26 — أداة ملفات (مجموعة العرض، المهمة 30):
# كتابة وقراءة ونسخ وإحصاء بعمليات حقيقية، ثم تنظيف كامل
# فيعيد المجلد كما كان.
استورد ملفات
أنشئ_مجلد("عرض-ملفات")
اكتب_ملف("عرض-ملفات/أول.txt"، "سطر أول\nسطر ثان\nسطر ثالث\n")
اكتب_ملف("عرض-ملفات/ثان.txt"، "نص ثان")
اكتب_ملف("عرض-ملفات/ثالث.txt"، "نص ثالث")
اطبع اقرأ_ملف("عرض-ملفات/أول.txt")
انسخ("عرض-ملفات/ثان.txt"، "عرض-ملفات/نسخة.txt")
اطبع اقرأ_ملف("عرض-ملفات/نسخة.txt")
اطبع عد_الملفات("عرض-ملفات")
اطبع نوع_المسار("عرض-ملفات/أول.txt")
م = ملفات.افتح("عرض-ملفات/ثالث.txt")
اطبع ملفات.اقرأ(م)
ملفات.اكتب(م، "نص جديد من الوحدة")
اطبع ملفات.اقرأ(م)
احذف_ملف("عرض-ملفات/أول.txt")
احذف_ملف("عرض-ملفات/ثان.txt")
احذف_ملف("عرض-ملفات/ثالث.txt")
احذف_ملف("عرض-ملفات/نسخة.txt")
احذف_مجلد("عرض-ملفات")
اطبع "تمت أداة الملفات"
