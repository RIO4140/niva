دالة استبعد(حل_خيارات، حل_اسم):
  حل_استبعد_قائمة = حل_خيار(حل_خيارات، "مستبعدة", [])
  حل_استبعد_قائمة.أضف(حل_اسم)
  ارجع حل_ضع_خيار(حل_خيارات، "مستبعدة"، حل_استبعد_قائمة)

# --- تحليل الشجرة والمثبت (§1 و§6 و§7) ---
دالة حل_اسم_في_فهرس(حل_فهرس، حل_اسم):
  لكل حل_إدخال_فهرس في حل_فهرس:
    إذا حل_إدخال_فهرس["اسم"] == حل_اسم:
      ارجع صحيح
    لكل حل_قدرة في حل_حقل(حل_إدخال_فهرس، "يوفر", []):
      إذا حل_قدرة == حل_اسم:
        ارجع صحيح
  ارجع خطأ

دالة مفقودة(حل_بيان، حل_فهرس):
  حل_مفقودة_نتيجة = []
  لكل حل_مفقودة_اعتماد في حل_حقل(حل_بيان، "اعتماديات", []):
    إذا حل_اسم_في_فهرس(حل_فهرس، حل_مفقودة_اعتماد["اسم"]) == خطأ:
      حل_مفقودة_نتيجة.أضف(حل_مفقودة_اعتماد)
  ارجع حل_مفقودة_نتيجة

دالة حل_مثبتة_إصدار(حل_مثبتة، حل_اسم):
  لكل حل_مثبتة_إدخال في حل_مثبتة:
    إذا حل_مثبتة_إدخال["اسم"] == حل_اسم:
      ارجع حل_مثبتة_إدخال["إصدار"]
  ارجع لاشيء

دالة مكسورة(حل_بيان، حل_مثبتة):
  حل_مكسورة_نتيجة = []
  لكل حل_مكسورة_اعتماد في حل_حقل(حل_بيان، "اعتماديات", []):
    حل_مكسورة_إصدار = حل_مثبتة_إصدار(حل_مثبتة، حل_مكسورة_اعتماد["اسم"])
    إذا حل_مكسورة_إصدار == لاشيء:
      حل_مكسورة_نتيجة.أضف(حل_مكسورة_اعتماد)
      تابع
    إذا حل_مكسورة_اعتماد["نوع"] == "الأحدث":
      تابع
    إذا حل_مكسورة_اعتماد["نوع"] == "مصدر":
      تابع
    حل_مكسورة_مطابقة = إصدار.يطابق(حل_مكسورة_اعتماد، حل_مكسورة_إصدار)
    إذا حل_مكسورة_مطابقة["نجاح"] == خطأ:
      حل_مكسورة_نتيجة.أضف(حل_مكسورة_اعتماد)
      تابع
    إذا حل_مكسورة_مطابقة["يطابق"] == خطأ:
      حل_مكسورة_نتيجة.أضف(حل_مكسورة_اعتماد)
  ارجع حل_مكسورة_نتيجة

دالة أصلح_المكسورة(حل_بيان، حل_مثبتة):
  حل_إصلاح_مكسورة = مكسورة(حل_بيان، حل_مثبتة)
  حل_إصلاح_خطة = []
  لكل حل_إصلاح_اعتماد في حل_إصلاح_مكسورة:
    حل_إصلاح_خطة.أضف({"حزمة": حل_إصلاح_اعتماد["اسم"]، "مواصفة": حل_إصلاح_اعتماد["مواصفة"]، "فعل": "ثبت"})
  ارجع {"نجاح": صحيح، "خطة": حل_إصلاح_خطة}

دالة أمامية(حل_بيان):
  حل_أمامية_نتيجة = []
  لكل حل_أمامية_اعتماد في حل_حقل(حل_بيان، "اعتماديات", []):
    حل_أمامية_نتيجة.أضف({"اسم": حل_أمامية_اعتماد["اسم"]، "مواصفة": حل_أمامية_اعتماد["مواصفة"]، "بدائل": بدائل(حل_بيان، حل_أمامية_اعتماد["اسم"])})
  ارجع حل_أمامية_نتيجة

دالة حل_اعتماديات_إدخال(حل_إدخال):
  ارجع حل_حقل(حل_إدخال، "اعتماديات", [])

دالة عكسية(حل_اسم، حل_فهرس):
  حل_عكسية_نتيجة = []
  لكل حل_عكسية_إدخال في حل_فهرس:
    لكل حل_عكسية_اعتماد في حل_اعتماديات_إدخال(حل_عكسية_إدخال):
      إذا حل_عكسية_اعتماد["اسم"] == حل_اسم:
        إذا حل_عكسية_إدخال["اسم"] في حل_عكسية_نتيجة == خطأ:
          حل_عكسية_نتيجة.أضف(حل_عكسية_إدخال["اسم"])
  ارجع حل_عكسية_نتيجة

دالة متكررة(حل_بيان، حل_فهرس):
  حل_متكررة_نتيجة = []
  حل_متكررة_طابور = []
  لكل حل_متكررة_اعتماد في حل_حقل(حل_بيان، "اعتماديات", []):
    حل_متكررة_طابور.أضف(حل_متكررة_اعتماد["اسم"])
  حل_متكررة_فهرس = ٠
  بينما حل_متكررة_فهرس < طول(حل_متكررة_طابور):
    حل_متكررة_اسم = حل_متكررة_طابور[حل_متكررة_فهرس]
    حل_متكررة_فهرس = حل_متكررة_فهرس + ١
    إذا حل_متكررة_اسم في حل_متكررة_نتيجة:
      تابع
    حل_متكررة_نتيجة.أضف(حل_متكررة_اسم)
    حل_متكررة_وجد = خطأ
    لكل حل_متكررة_إدخال في حل_فهرس:
      إذا حل_متكررة_وجد == خطأ:
        إذا حل_متكررة_إدخال["اسم"] == حل_متكررة_اسم:
          لكل حل_متكررة_اعتماد_جديد في حل_اعتماديات_إدخال(حل_متكررة_إدخال):
            حل_متكررة_طابور.أضف(حل_متكررة_اعتماد_جديد["اسم"])
          حل_متكررة_وجد = صحيح
  ارجع حل_متكررة_نتيجة

دالة أمامية_المثبت(حل_بيان، حل_مثبتة):
  حل_أمامية_مثبت_نتيجة = []
  لكل حل_أمامية_مثبت_اعتماد في أمامية(حل_بيان):
    إذا حل_مثبتة_إصدار(حل_مثبتة، حل_أمامية_مثبت_اعتماد["اسم"]) != لاشيء:
      حل_أمامية_مثبت_نتيجة.أضف(حل_أمامية_مثبت_اعتماد)
  ارجع حل_أمامية_مثبت_نتيجة

دالة مهمة(حل_بيان):
  حل_مهمة_نتيجة = []
  لكل حل_مهمة_اعتماد في حل_حقل(حل_بيان، "اعتماديات", []):
    حل_مهمة_نتيجة.أضف(حل_مهمة_اعتماد)
  لكل حل_مهمة_قبل في حل_حقل(حل_بيان، "قبل_التثبيت", []):
    حل_مهمة_وجد = خطأ
    لكل حل_مهمة_قديم في حل_مهمة_نتيجة:
      إذا حل_مهمة_قديم["اسم"] == حل_مهمة_قبل["اسم"]:
        حل_مهمة_وجد = صحيح
    إذا حل_مهمة_وجد == خطأ:
      حل_مهمة_نتيجة.أضف(حل_مهمة_قبل)
  ارجع حل_مهمة_نتيجة

دالة شجرة(حل_بيان، حل_فهرس):
  حل_شجرة_سطور = [حل_بيان["اسم"]]
  حل_شجرة_رأيتها = [حل_بيان["اسم"]]
  حل_شجرة_طابور = []
  لكل حل_شجرة_اعتماد في حل_حقل(حل_بيان، "اعتماديات", []):
    حل_شجرة_طابور.أضف({"اسم": حل_شجرة_اعتماد["اسم"]، "عمق": ١})
  حل_شجرة_فهرس = ٠
  بينما حل_شجرة_فهرس < طول(حل_شجرة_طابور):
    حل_شجرة_عنصر = حل_شجرة_طابور[حل_شجرة_فهرس]
    حل_شجرة_فهرس = حل_شجرة_فهرس + ١
    حل_شجرة_مسافة = ""
    حل_شجرة_عد = ٠
    بينما حل_شجرة_عد < حل_شجرة_عنصر["عمق"]:
      حل_شجرة_مسافة = حل_شجرة_مسافة + "  "
      حل_شجرة_عد = حل_شجرة_عد + ١
    إذا حل_شجرة_عنصر["اسم"] في حل_شجرة_رأيتها:
      حل_شجرة_سطور.أضف(حل_شجرة_مسافة + حل_شجرة_عنصر["اسم"] + " (مكرر)")
      تابع
    حل_شجرة_رأيتها.أضف(حل_شجرة_عنصر["اسم"])
    حل_شجرة_سطور.أضف(حل_شجرة_مسافة + حل_شجرة_عنصر["اسم"])
    حل_شجرة_وجد = خطأ
    لكل حل_شجرة_إدخال في حل_فهرس:
      إذا حل_شجرة_وجد == خطأ:
        إذا حل_شجرة_إدخال["اسم"] == حل_شجرة_عنصر["اسم"]:
          لكل حل_شجرة_اعتماد_جديد في حل_اعتماديات_إدخال(حل_شجرة_إدخال):
            حل_شجرة_طابور.أضف({"اسم": حل_شجرة_اعتماد_جديد["اسم"]، "عمق": حل_شجرة_عنصر["عمق"] + ١})
          حل_شجرة_وجد = صحيح
  حل_شجرة_نص = ""
  حل_شجرة_أول = صحيح
  لكل حل_شجرة_سطر في حل_شجرة_سطور:
    إذا حل_شجرة_أول == خطأ:
      حل_شجرة_نص = حل_شجرة_نص + "\n"
    حل_شجرة_نص = حل_شجرة_نص + حل_شجرة_سطر
    حل_شجرة_أول = خطأ
  ارجع حل_شجرة_نص

دالة بدل(حل_قفل، حل_قديم، حل_جديد):
  حل_بدل_وجد = خطأ
  حل_بدل_نتيجة = []
  لكل حل_بدل_إدخال في حل_قفل:
    إذا حل_بدل_إدخال["اسم"] == حل_قديم:
      حل_بدل_نتيجة.أضف(حل_جديد)
      حل_بدل_وجد = صحيح
    وإلا:
      حل_بدل_نتيجة.أضف(حل_بدل_إدخال)
  إذا حل_بدل_وجد == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + حل_قديم + " غير موجودة في القفل"}
  ارجع {"نجاح": صحيح، "قفل": حل_بدل_نتيجة}

دالة عرض_شامل(حل_اسم، حل_بيان، حل_فهرس):
  ارجع {"اسم": حل_اسم، "أمامية": أمامية(حل_بيان)، "عكسية": عكسية(حل_اسم، حل_فهرس)}

دالة من_يوفر(حل_قدرة، حل_فهرس):
  حل_يوفر_نتيجة = []
  لكل حل_يوفر_إدخال في حل_فهرس:
    إذا حل_يوفر_إدخال["اسم"] == حل_قدرة:
      حل_يوفر_نتيجة.أضف(حل_يوفر_إدخال["اسم"])
      تابع
    لكل حل_يوفر_قدرة في حل_حقل(حل_يوفر_إدخال، "يوفر", []):
      إذا حل_يوفر_قدرة == حل_قدرة:
        إذا حل_يوفر_إدخال["اسم"] في حل_يوفر_نتيجة == خطأ:
          حل_يوفر_نتيجة.أضف(حل_يوفر_إدخال["اسم"])
  ارجع حل_يوفر_نتيجة

دالة حل_مطلوبة_من(حل_اسم، حل_مثبتة، حل_فهرس):
  لكل حل_مطلوبة_مثبتة في حل_مثبتة:
    إذا حل_مطلوبة_مثبتة["اسم"] == حل_اسم:
      تابع
    لكل حل_مطلوبة_إدخال في حل_فهرس:
      إذا حل_مطلوبة_إدخال["اسم"] == حل_مطلوبة_مثبتة["اسم"]:
        لكل حل_مطلوبة_اعتماد في حل_اعتماديات_إدخال(حل_مطلوبة_إدخال):
          إذا حل_مطلوبة_اعتماد["اسم"] == حل_اسم:
            ارجع صحيح
  ارجع خطأ

دالة يتامى(حل_مثبتة، حل_فهرس):
  حل_يتامى_نتيجة = []
  لكل حل_يتامى_مثبتة في حل_مثبتة:
    إذا حل_حقل(حل_يتامى_مثبتة، "صريح"، خطأ) == صحيح:
      تابع
    إذا حل_مطلوبة_من(حل_يتامى_مثبتة["اسم"]، حل_مثبتة، حل_فهرس) == خطأ:
      حل_يتامى_نتيجة.أضف(حل_يتامى_مثبتة)
  ارجع حل_يتامى_نتيجة

دالة غير_المطلوبة(حل_مثبتة، حل_فهرس):
  حل_غير_نتيجة = []
  لكل حل_غير_مثبتة في حل_مثبتة:
    إذا حل_مطلوبة_من(حل_غير_مثبتة["اسم"]، حل_مثبتة، حل_فهرس) == خطأ:
      حل_غير_نتيجة.أضف(حل_غير_مثبتة)
  ارجع حل_غير_نتيجة

دالة يتامى_صريحة(حل_مثبتة، حل_فهرس):
  حل_يتامى_صريحة_نتيجة = []
  لكل حل_يتامى_صريحة_مثبتة في حل_مثبتة:
    إذا حل_حقل(حل_يتامى_صريحة_مثبتة، "صريح"، خطأ) == خطأ:
      تابع
    إذا حل_مطلوبة_من(حل_يتامى_صريحة_مثبتة["اسم"]، حل_مثبتة، حل_فهرس) == خطأ:
      حل_يتامى_صريحة_نتيجة.أضف(حل_يتامى_صريحة_مثبتة)
  ارجع حل_يتامى_صريحة_نتيجة
