دالة بدائل(حل_بيان، حل_اعتماد):
  حل_بدائل_نتيجة = []
  لكل حل_بدائل_إدخال في حل_حقل(حل_بيان، "بدائل", []):
    إذا حل_بدائل_إدخال["اسم"] == حل_اعتماد:
      حل_بدائل_نتيجة.أضف(حل_بدائل_إدخال["بديل"])
  ارجع حل_بدائل_نتيجة

# --- ضابطات الخيارات (§1 و§2) — ترجع قاموس الخيارات نفسه ---
دالة حل_ضع_خيار(حل_خيارات، حل_مفتاح، حل_قيمة):
  إذا حل_خيارات == لاشيء:
    حل_خيارات = {}
  حل_خيارات[حل_مفتاح] = حل_قيمة
  ارجع حل_خيارات

دالة بلا_موصى_بها(حل_خيارات):
  ارجع حل_ضع_خيار(حل_خيارات، "بلا_موصى_بها"، صحيح)

دالة بالمقترحة_كاعتماد(حل_خيارات):
  ارجع حل_ضع_خيار(حل_خيارات، "بالمقترحة_كاعتماد"، صحيح)

دالة من_قناة(حل_خيارات، حل_قناة):
  ارجع حل_ضع_خيار(حل_خيارات، "قناة"، حل_قناة)

دالة بترقية_ذكية(حل_خيارات):
  ارجع حل_ضع_خيار(حل_خيارات، "ترقية_ذكية"، صحيح)

دالة بترقية_دنيا(حل_خيارات):
  ارجع حل_ضع_خيار(حل_خيارات، "ترقية_دنيا"، صحيح)

دالة بحزم_جديدة(حل_خيارات):
  ارجع حل_ضع_خيار(حل_خيارات، "بحزم_جديدة"، صحيح)

دالة بحدث_أولا(حل_خيارات):
  ارجع حل_ضع_خيار(حل_خيارات، "حدث_أولا"، صحيح)

