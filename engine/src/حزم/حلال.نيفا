  ارجع حل_ضع_خيار(حل_خيارات، "أمني_فقط"، صحيح)

دالة باستشارة(حل_خيارات، حل_رقم):
  ارجع حل_ضع_خيار(حل_خيارات، "استشارة"، حل_رقم)

دالة بثغرة(حل_خيارات، حل_رقم):
  ارجع حل_ضع_خيار(حل_خيارات، "ثغرة"، حل_رقم)

