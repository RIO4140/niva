# تنسيق الإخراج (--هادئ سطر أول، --مطول يضيف التفصيل،
# --تقدم يضيف سطر اكتمال) — البنود 283 و284 و287.
دالة نسّق_الإخراج(نس_نص، نس_تفصيل، نس_خيارات):
  إذا نس_خيارات == لاشيء:
    ارجع نس_نص
  إذا "هادئ" في نس_خيارات:
    إذا نس_خيارات["هادئ"]:
      نس_سطور = نس_نص.قسم("\n")
      ارجع نس_سطور[٠]
  إذا "مطول" في نس_خيارات:
    إذا نس_خيارات["مطول"]:
      ارجع نس_نص + "\n" + نس_تفصيل
  إذا "تقدم" في نس_خيارات:
    إذا نس_خيارات["تقدم"]:
      ارجع نس_نص + "\nتقدم: اكتمل"
  إذا "تصحيح" في نس_خيارات:
    إذا نس_خيارات["تصحيح"]:
      ارجع نس_نص + "\nتصحيح: " + نس_تفصيل
  إذا "مستوى_تصحيح" في نس_خيارات:
    إذا نس_خيارات["مستوى_تصحيح"] == "مفصل":
      ارجع نس_نص + "\n" + نس_تفصيل
  ارجع نس_نص

# قراءة الفهرس المحلل للفروع التي تحتاجه (محفوظ أو --فهرس).
دالة اقرأ_فهرس_فرع(فه_وسائط):
  فه_خيارات = {"مجلد_فهرس": قيمة_راية(فه_وسائط، "فهرس"), "تنزيل": خطأ}
  ارجع سجل.اقرأ_الفهرس(فه_خيارات)

# توسيع اختصار مستخدم من حزم/اختصارات (سطر `اسم=أمر...`)
# — مستوى واحد فقط، بلا توسيع متكرر.
دالة وسّع_اختصار(اخ_وسائط):
  إذا طول(اخ_وسائط) == ٠:
    ارجع اخ_وسائط
  اخ_مسار = "حزم/اختصارات"
  إذا موجود(اخ_مسار) == خطأ:
    ارجع اخ_وسائط
  حاول:
    اخ_نص = اقرأ_ملف(اخ_مسار)
  ماعدا:
    ارجع اخ_وسائط
  لكل اخ_سطر في اخ_نص.قسم("\n"):
    اخ_مقصوص = اخ_سطر.قص()
    إذا اخ_مقصوص == "":
      تابع
    اخ_مساواة = ٠ - ١
    اخ_فهرس = ٠
    بينما اخ_فهرس < طول(اخ_مقصوص):
      إذا اخ_مقصوص[اخ_فهرس] == "=":
        اخ_مساواة = اخ_فهرس
        اكسر
      اخ_فهرس = اخ_فهرس + ١
    إذا اخ_مساواة < ٠:
      تابع
    اخ_اسم = نصوص.قبل_الفهرس(اخ_مقصوص، اخ_مساواة).قص()
    إذا اخ_اسم != اخ_وسائط[٠]:
      تابع
    اخ_قيمة = نصوص.من_الفهرس(اخ_مقصوص، اخ_مساواة + ١).قص()
    اخ_كلمات = نصوص.قسم_كلمات(اخ_قيمة)
    اخ_جديدة = []
    لكل اخ_كلمة في اخ_كلمات:
      اخ_جديدة.أضف(اخ_كلمة)
    اخ_باقي = ١
    بينما اخ_باقي < طول(اخ_وسائط):
      اخ_جديدة.أضف(اخ_وسائط[اخ_باقي])
      اخ_باقي = اخ_باقي + ١
