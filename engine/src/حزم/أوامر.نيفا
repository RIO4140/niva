  جل_نتائج = []
  لكل جل_أمر في جل_أوامر:
    جل_نتيجة = نفّذ(جل_أمر، جل_فهرس، جل_خيارات)
    إذا جل_نتيجة["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": جل_نتيجة["خطأ"]، "نتائج": جل_نتائج}
    جل_نتائج.أضف(جل_نتيجة["نص"])
  ارجع {"نجاح": صحيح، "نتائج": جل_نتائج}

