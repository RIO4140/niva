# المخزن العام «$نيفا/.نيفا/حزم/» — إنشاء وحجم وسقف وتثبيت محلي (التصميم §10)
# «$نيفا» في نيفا هو مجلد البرنامج، والبيت `~` تحته — فالمخزن في
# التطبيق مجلد ملفات التطبيق الخاص، وعلى سطح المكتب مجلد البرنامج
# الذي يعمل منه المدير. (اجتماع 45 §59: بعد الفصل صار المخزن
# تحت مجلد البرنامج لا تحت البيت.)
# وكل دوال هذه الوحدة ترجع قاموس نتيجة: {"نجاح": صحيح، ...} أو
# {"نجاح": خطأ، "خطأ": "رسالة عربية"}.
صدر مسار_المخزن، تأكد_المخزن، حجم_المخزن، تحقق_سقف_المخزن، تحقق_حزمة، ثبّت_محليا، احسب_حجم_مجلد، ملف_ضمن_السقف، تحقق_توقيع، مفاتيح_موثوقة، تحقق_بصمة_ملف، بصمة_ثلاثية، احفظ_إعداد_جديد، احفظ_إعداد_عند_الحذف، بصمة_ملف، تحقق_ذاكرة_موقعة، تحقق_المخزن، أصلح_المخزن، اجمع_القمامة، اجمع_القمامة_مع_الأجيال، حجم_الإغلاق، معلومات_ملف، ملفات_من_ملف، بتنظيف_تلقائي، بجاهز، بتنزيل_معزول
استورد نص باسم نصوص
استورد إصدار
استورد بيان
استورد تشفير
استورد جسون
استورد وقت

دالة مسار_المخزن():
  ارجع "$نيفا/.نيفا/حزم"

دالة ملف_ضمن_السقف(حجم):
  إذا حجم > ٥٢٤٢٨٨٠:
    ارجع {"نجاح": خطأ، "خطأ": "الملف أكبر من 5 ميبيبايت"}
  ارجع {"نجاح": صحيح}

دالة اجمع_مسار(أسماء):
  نتيجة = ""
  لكل اسم في أسماء:
    إذا نتيجة == "":
      نتيجة = اسم
    وإلا:
      نتيجة = نتيجة + "/" + اسم
  ارجع نتيجة

دالة سرد_الشجرة():
  حاول:
    خام = اعرض_الشجرة()
    مدخلات = []
    مكدس_أسماء = []
    مكدس_عمق = []
    لكل سطر في خام:
      عمق = نصوص.عدد_مسافات_بادئة(سطر)
      اسم_خام = سطر.قص()
      مجلد = نصوص.ينتهي_ب(اسم_خام، "/")
      اسم = اسم_خام.استبدل("/", "")
      بينما طول(مكدس_عمق) > ٠:
        إذا مكدس_عمق[طول(مكدس_عمق) - ١] >= عمق:
          مكدس_أسماء.أزل()
          مكدس_عمق.أزل()
        وإلا:
          اكسر
      مكدس_أسماء.أضف(اسم)
      مكدس_عمق.أضف(عمق)
      مسار_مدخل = اجمع_مسار(مكدس_أسماء)
      نوع = "ملف"
      إذا مجلد:
        نوع = "مجلد"
      مدخلات.أضف({"مسار": مسار_مدخل، "نوع": نوع})
    ارجع {"نجاح": صحيح، "مدخلات": مدخلات}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر سرد شجرة الملفات"}

دالة جرد_بادئة(مسار):
  بادئة = مسار
  # اجتماع 45 §59: مسار `$نيفا/...` يمر كما هو — المحرك
  # يوسّعه إلى مجلد البرنامج؛ و`~/...` تُجرَّد إلى النسبي
  # (يُحل ضد البيت، مجلد الجلسة الحالي).
  إذا نصوص.يبدأ_ب(بادئة، "$نيفا/"):
    ارجع بادئة
  إذا نصوص.يبدأ_ب(بادئة، "~/"):
    بادئة = نصوص.من_الفهرس(بادئة، ٢)
  ارجع بادئة

دالة احسب_حجم_مجلد(مسار):
  بادئة = جرد_بادئة(مسار)
  حاول:
    حجم = حجم_المسار(بادئة)
    ارجع {"نجاح": صحيح، "حجم": حجم}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر حساب حجم المجلد: " + مسار}

دالة حجم_المخزن():
  إذا موجود("$نيفا/.نيفا/حزم") == خطأ:
    ارجع {"نجاح": صحيح، "حجم": ٠}
  ارجع احسب_حجم_مجلد("$نيفا/.نيفا/حزم")

دالة تحقق_سقف_المخزن(إضافي):
  حالي = حجم_المخزن()
  إذا حالي["نجاح"] == خطأ:
    ارجع حالي
  سقف = ١٠٢٤ * ١٠٢٤ * ١٠٢٤
  إذا حالي["حجم"] + إضافي > سقف:
    ارجع {"نجاح": خطأ، "خطأ": "مخزن الحزم ممتلئ (1 غيغابايت) — احذف حزمة أو امسح الذاكرة"}
  ارجع {"نجاح": صحيح، "حجم": حالي["حجم"]}

دالة تأكد_المخزن():
  مجلدات = ["$نيفا/.نيفا"، "$نيفا/.نيفا/حزم"، "$نيفا/.نيفا/حزم/ذاكرة"، "$نيفا/.نيفا/حزم/فهرس"]
  لكل مجلد في مجلدات:
    إذا موجود(مجلد) == خطأ:
      حاول:
        أنشئ_مجلد(مجلد)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء المخزن: " + مجلد}
  ارجع {"نجاح": صحيح}

دالة تحقق_حزمة(مسار_مجلد):
  مسار = جرد_بادئة(مسار_مجلد)
  إذا موجود(مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "مجلد الحزمة غير موجود: " + مسار_مجلد}
  إذا نوع_المسار(مسار) != "مجلد":
    ارجع {"نجاح": خطأ، "خطأ": "مجلد الحزمة غير موجود: " + مسار_مجلد}
  مسار_البيان = مسار + "/بيان.حزمة"
  إذا موجود(مسار_البيان) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة بلا بيان: " + مسار_مجلد}
  ن_بيان = بيان.اقرأ_بيان(مسار_البيان)
  إذا ن_بيان["نجاح"] == خطأ:
    ارجع ن_بيان
  بيان_الحزمة = ن_بيان["بيان"]
  إذا بيان_الحزمة["نسخة_نيفا"] != لاشيء:
    ن_نسخة = إصدار.تحقق_نسخة_نيفا(بيان_الحزمة["نسخة_نيفا"])
    إذا ن_نسخة["نجاح"] == خطأ:
      ارجع ن_نسخة
  ن_سرد = سرد_الشجرة()
  إذا ن_سرد["نجاح"] == خطأ:
    ارجع ن_سرد
  ملفات = []
  مجموع = ٠
  لكل مدخل في ن_سرد["مدخلات"]:
    إذا نصوص.يبدأ_ب(مدخل["مسار"]، مسار + "/"):
      إذا مدخل["نوع"] == "ملف":
        اسم_الملف = نصوص.اسم_الملف(مدخل["مسار"])
        إذا اسم_الملف != "بيان.حزمة":
          إذا اسم_الملف != "قفل.حزمة":
            إذا نصوص.ينتهي_ب(اسم_الملف، ".نيفا") == خطأ:
              ارجع {"نجاح": خطأ، "خطأ": "ملف غير مسموح في الحزمة " + بيان_الحزمة["اسم"] + ": " + اسم_الملف}
        حجم = حجم_المسار(مدخل["مسار"])
        ن_سقف = ملف_ضمن_السقف(حجم)
        إذا ن_سقف["نجاح"] == خطأ:
          ارجع {"نجاح": خطأ، "خطأ": "ملف الحزمة أكبر من 5 ميبيبايت: " + اسم_الملف}
        مجموع = مجموع + حجم
        ملفات.أضف(مدخل["مسار"])
  ارجع {"نجاح": صحيح، "بيان": بيان_الحزمة، "ملفات": ملفات، "حجم": مجموع}

دالة ثبّت_محليا(مسار_حزمة):
  مسار = جرد_بادئة(مسار_حزمة)
  ن_تحقق = تحقق_حزمة(مسار)
  إذا ن_تحقق["نجاح"] == خطأ:
    ارجع ن_تحقق
  بيان_الحزمة = ن_تحقق["بيان"]
  ن_مخزن = تأكد_المخزن()
  إذا ن_مخزن["نجاح"] == خطأ:
    ارجع ن_مخزن
  هدف = "$نيفا/.نيفا/حزم/" + بيان_الحزمة["اسم"] + "-" + بيان_الحزمة["إصدار"]
  إذا موجود(هدف):
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + بيان_الحزمة["اسم"] + " مثبّتة أصلا — احذفها أولا لإعادة تثبيتها"}
  ن_سقف = تحقق_سقف_المخزن(ن_تحقق["حجم"])
  إذا ن_سقف["نجاح"] == خطأ:
    ارجع ن_سقف
  مؤقت = هدف + ".مؤقت"
  إذا موجود(مؤقت):
    ارجع {"نجاح": خطأ، "خطأ": "يوجد تثبيت مؤقت عالق: " + مؤقت}
  حاول:
    أنشئ_مجلد(مؤقت)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد التثبيت: " + مؤقت}
  ن_سرد = سرد_الشجرة()
  إذا ن_سرد["نجاح"] == خطأ:
    ارجع ن_سرد
  لكل مدخل في ن_سرد["مدخلات"]:
    إذا نصوص.يبدأ_ب(مدخل["مسار"]، مسار + "/"):
      إذا مدخل["نوع"] == "مجلد":
        نسبي = نصوص.من_الفهرس(مدخل["مسار"]، طول(مسار) + ١)
        حاول:
          أنشئ_مجلد(مؤقت + "/" + نسبي)
        ماعدا:
          ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد التثبيت: " + نسبي}
  لكل مسار_ملف في ن_تحقق["ملفات"]:
    نسبي = نصوص.من_الفهرس(مسار_ملف، طول(مسار) + ١)
    حاول:
      انسخ(مسار_ملف، مؤقت + "/" + نسبي)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر نسخ ملف الحزمة: " + نسبي}
  حاول:
    نص_المصدر = اقرأ_ملف(مسار + "/بيان.حزمة")
    نص_المنسوخ = اقرأ_ملف(مؤقت + "/بيان.حزمة")
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الحزمة " + بيان_الحزمة["اسم"] + " بعد التثبيت"}
  إذا نص_المصدر != نص_المنسوخ:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الحزمة " + بيان_الحزمة["اسم"] + " بعد التثبيت"}
  حاول:
    انقل(مؤقت، هدف)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر تثبيت الحزمة " + بيان_الحزمة["اسم"]}
  ارجع {"نجاح": صحيح، "مسار": "$نيفا/.نيفا/حزم/" + بيان_الحزمة["اسم"] + "-" + بيان_الحزمة["إصدار"]، "حجم": ن_تحقق["حجم"]}

# --- التوقيع والبصمات (الدفعة 9، §4) ---
# الفهرس هنا قائمة إدخالات محللة (من سجل.حلّل_فهرس).
دالة خز_ضع_خيار(خز_خيارات، خز_مفتاح، خز_قيمة):
  إذا خز_خيارات == لاشيء:
    خز_خيارات = {}
  خز_خيارات[خز_مفتاح] = خز_قيمة
  ارجع خز_خيارات

دالة تحقق_توقيع(خزت_اسم، خزت_فهرس، خزت_ناشر):
  خزت_إصدارات = []
  لكل خزت_إدخال في خزت_فهرس:
    إذا خزت_إدخال["اسم"] == خزت_اسم:
      خزت_إصدارات.أضف(خزت_إدخال["إصدار"])
  إذا طول(خزت_إصدارات) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + خزت_اسم + " غير موجودة في الفهرس"}
  خزت_اختيار = إصدار.اختر_إصدار(خزت_اسم، {"نوع": "الأحدث"، "مواصفة": "الأحدث"}، خزت_إصدارات)
  إذا خزت_اختيار["نجاح"] == خطأ:
    ارجع خزت_اختيار
  لكل خزت_إدخال_ثان في خزت_فهرس:
    إذا خزت_إدخال_ثان["اسم"] == خزت_اسم:
      إذا خزت_إدخال_ثان["إصدار"] == خزت_اختيار["إصدار"]:
        إذا خزت_إدخال_ثان["ناشر"] == خزت_ناشر:
          ارجع {"نجاح": صحيح، "اسم": خزت_اسم، "إصدار": خزت_اختيار["إصدار"]، "ناشر": خزت_ناشر}
        ارجع {"نجاح": خطأ، "خطأ": "الناشر " + خزت_إدخال_ثان["ناشر"] + " غير موثوق للحزمة " + خزت_اسم}
  ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + خزت_اسم + " غير موجودة في الفهرس"}

دالة مفاتيح_موثوقة():
  خزم_مسار = "$نيفا/.نيفا/حزم/فهرس/بصمة.فهرس"
  إذا موجود(خزم_مسار) == خطأ:
    ارجع []
  حاول:
    خزم_بصمة = اقرأ_ملف(خزم_مسار).قص()
    ارجع [{"مصدر": "الفهرس الرسمي"، "بصمة": خزم_بصمة}]
  ماعدا:
    ارجع []

دالة تحقق_بصمة_ملف(خزب_مسار، خزب_بصمة):
  إذا موجود(خزب_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الملف غير موجود: " + خزب_مسار}
  حاول:
    خزب_محسوبة = تشفير.جزّئ(اقرأ_ملف(خزب_مسار))
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة الملف: " + خزب_مسار}
  إذا خزب_محسوبة == خزب_بصمة:
    ارجع {"نجاح": صحيح}
  ارجع {"نجاح": خطأ، "خطأ": "بصمة الملف لا تطابق: " + خزب_مسار}

دالة بصمة_ثلاثية(خزث_أصلي، خزث_جديد، خزث_حالي):
  خزث_بصمات = {"أصلي": تشفير.جزّئ(خزث_أصلي)، "جديد": تشفير.جزّئ(خزث_جديد)، "حالي": تشفير.جزّئ(خزث_حالي)}
  إذا خزث_حالي == خزث_أصلي:
    ارجع {"نجاح": صحيح، "قرار": "استبدل بالجديد"، "بصمات": خزث_بصمات}
  إذا خزث_حالي == خزث_جديد:
    ارجع {"نجاح": صحيح، "قرار": "احتفظ"، "بصمات": خزث_بصمات}
  إذا خزث_جديد == خزث_أصلي:
    ارجع {"نجاح": صحيح، "قرار": "احتفظ"، "بصمات": خزث_بصمات}
  ارجع {"نجاح": صحيح، "قرار": "اسأل المستخدم"، "بصمات": خزث_بصمات}

دالة احفظ_إعداد_جديد(خزج_مسار، خزج_نص):
  إذا موجود(خزج_مسار):
    خزج_جديد = خزج_مسار + ".جديد"
    حاول:
      اكتب_ملف(خزج_جديد، خزج_نص)
      ارجع {"نجاح": صحيح، "مسار": خزج_جديد، "تحذير": "الملف موجود — حُفظ بنسخة جديدة"}
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة الإعداد الجديد: " + خزج_جديد}
  حاول:
    اكتب_ملف(خزج_مسار، خزج_نص)
    ارجع {"نجاح": صحيح، "مسار": خزج_مسار}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة الإعداد: " + خزج_مسار}

دالة احفظ_إعداد_عند_الحذف(خزح_مسار):
  إذا موجود(خزح_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الملف غير موجود: " + خزح_مسار}
  خزح_نسخة = خزح_مسار + ".محفوظ"
  حاول:
    انسخ(خزح_مسار، خزح_نسخة)
    احذف(خزح_مسار)
    ارجع {"نجاح": صحيح، "نسخة": خزح_نسخة}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر حفظ الإعداد عند الحذف: " + خزح_مسار}

دالة بصمة_ملف(خزبص_مسار):
  إذا موجود(خزبص_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الملف غير موجود: " + خزبص_مسار}
  حاول:
    خزبص_نص = اقرأ_ملف(خزبص_مسار)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة الملف: " + خزبص_مسار}
  ارجع {"نجاح": صحيح، "شا256": تشفير.جزّئ(خزبص_نص)، "شا512": تشفير.بصمة_شا_512(خزبص_نص)، "إم_دي_5": تشفير.بصمة_إم_دي_5(خزبص_نص)}

دالة تحقق_ذاكرة_موقعة(خزذ_مسار، خزذ_بصمة):
  إذا موجود(خزذ_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "ذاكرة غير موجودة: " + خزذ_مسار}
  خزذ_توقيع = خزذ_مسار + ".توقيع"
  إذا موجود(خزذ_توقيع) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "ذاكرة بلا توقيع: " + خزذ_مسار}
  حاول:
    خزذ_نص_توقيع = اقرأ_ملف(خزذ_توقيع).قص()
    خزذ_محسوبة = تشفير.جزّئ(اقرأ_ملف(خزذ_مسار))
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة الذاكرة الموقعة: " + خزذ_مسار}
  إذا خزذ_نص_توقيع != خزذ_بصمة:
    ارجع {"نجاح": خطأ، "خطأ": "توقيع الذاكرة لا يطابق البصمة: " + خزذ_مسار}
  إذا خزذ_محسوبة != خزذ_بصمة:
    ارجع {"نجاح": خطأ، "خطأ": "بصمة الذاكرة لا تطابق: " + خزذ_مسار}
  ارجع {"نجاح": صحيح}

# --- سلامة المخزن وجمع القمامة (§6) ---
دالة خز_مجلدات_المخزن():
  خز_سرد = سرد_الشجرة()
  إذا خز_سرد["نجاح"] == خطأ:
    ارجع خز_سرد
  خز_مجلدات = []
  لكل خز_مدخل في خز_سرد["مدخلات"]:
    إذا خز_مدخل["نوع"] != "مجلد":
      تابع
    إذا نصوص.يبدأ_ب(خز_مدخل["مسار"]، ".نيفا/حزم/") == خطأ:
      تابع
    خز_باقي = نصوص.من_الفهرس(خز_مدخل["مسار"]، طول(".نيفا/حزم/"))
    إذا خز_باقي.يحتوي("/"):
      تابع
    إذا خز_باقي == "":
      تابع
    خز_مجلدات.أضف("$نيفا/.نيفا/حزم/" + خز_باقي)
  ارجع {"نجاح": صحيح، "مجلدات": خز_مجلدات}

دالة تحقق_المخزن():
  خزت_سرد = خز_مجلدات_المخزن()
  إذا خزت_سرد["نجاح"] == خطأ:
    ارجع خزت_سرد
  خزت_سليم = ٠
  خزت_تالف = []
  لكل خزت_مجلد في خزت_سرد["مجلدات"]:
    خزت_فحص = تحقق_حزمة(خزت_مجلد)
    إذا خزت_فحص["نجاح"]:
      خزت_سليم = خزت_سليم + ١
    وإلا:
      خزت_تالف.أضف({"مسار": خزت_مجلد، "خطأ": خزت_فحص["خطأ"]})
  ارجع {"نجاح": طول(خزت_تالف) == ٠، "سليم": خزت_سليم، "تالف": خزت_تالف}

دالة أصلح_المخزن():
  خزص_فحص = تحقق_المخزن()
  إذا خزص_فحص["نجاح"]:
    ارجع {"نجاح": صحيح، "أصلح": []}
  خزص_أصلح = []
  لكل خزص_تالف في خزص_فحص["تالف"]:
    حاول:
      انقل(خزص_تالف["مسار"]، خزص_تالف["مسار"] + ".تالف")
      خزص_أصلح.أضف(خزص_تالف["مسار"])
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر عزل الحزمة التالفة: " + خزص_تالف["مسار"]}
  ارجع {"نجاح": صحيح، "أصلح": خزص_أصلح}

دالة خز_محمية(خز_أساس):
  خز_أسماء = []
  خز_مجلد_أجيال = خز_أساس + "/حزم/أجيال"
  إذا خز_أساس == "":
    خز_مجلد_أجيال = "حزم/أجيال"
  حاول:
    خز_خام = اعرض_الشجرة()
  ماعدا:
    ارجع خز_أسماء
  لكل خز_سطر في خز_خام:
    خز_مسار = خز_سطر.قص()
    إذا نصوص.يبدأ_ب(خز_مسار، خز_مجلد_أجيال + "/") == خطأ:
      تابع
    إذا نصوص.ينتهي_ب(خز_مسار، "/بيان.json") == خطأ:
      تابع
    حاول:
      خز_جيل = جسون.اقرأ(اقرأ_ملف(خز_مسار))
      لكل خز_حزمة في خز_جيل["حزم"]:
        إذا خز_حزمة["اسم"] في خز_أسماء == خطأ:
          خز_أسماء.أضف(خز_حزمة["اسم"])
    ماعدا:
      تابع
  خز_مسار_بيان = خز_أساس + "/بيان.حزمة"
  إذا خز_أساس == "":
    خز_مسار_بيان = "بيان.حزمة"
  إذا موجود(خز_مسار_بيان):
    خز_بيان = بيان.اقرأ_بيان(خز_مسار_بيان)
    إذا خز_بيان["نجاح"]:
      لكل خز_اعتماد في خز_بيان["بيان"]["اعتماديات"]:
        إذا خز_اعتماد["اسم"] في خز_أسماء == خطأ:
          خز_أسماء.أضف(خز_اعتماد["اسم"])
  ارجع خز_أسماء

دالة اجمع_القمامة(خزق_أساس):
  خزق_تأكد = تأكد_المخزن()
  إذا خزق_تأكد["نجاح"] == خطأ:
    ارجع خزق_تأكد
  خزق_محمية = خز_محمية(خزق_أساس)
  خزق_سرد = خز_مجلدات_المخزن()
  إذا خزق_سرد["نجاح"] == خطأ:
    ارجع خزق_سرد
  خزق_قمامة = "$نيفا/.نيفا/حزم/.قمامة"
  إذا موجود(خزق_قمامة) == خطأ:
    حاول:
      أنشئ_مجلد(خزق_قمامة)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد القمامة"}
  خزق_عدد = ٠
  خزق_حرر = ٠
  لكل خزق_مجلد في خزق_سرد["مجلدات"]:
    خزق_اسم_مجلد = نصوص.اسم_الملف(خزق_مجلد)
    إذا خزق_اسم_مجلد == ".قمامة":
      تابع
    إذا نصوص.ينتهي_ب(خزق_اسم_مجلد، ".تالف"):
      تابع
    خزق_نقطة = ٠ - ١
    خزق_فهرس = ٠
    بينما خزق_فهرس < طول(خزق_اسم_مجلد):
      إذا خزق_اسم_مجلد[خزق_فهرس] == "-":
        خزق_نقطة = خزق_فهرس
        اكسر
      خزق_فهرس = خزق_فهرس + ١
    إذا خزق_نقطة < ٠:
      تابع
    خزق_اسم = نصوص.قبل_الفهرس(خزق_اسم_مجلد، خزق_نقطة)
    إذا خزق_اسم في خزق_محمية:
      تابع
    خزق_حجم = احسب_حجم_مجلد(خزق_مجلد)
    حاول:
      انقل(خزق_مجلد، خزق_قمامة + "/" + خزق_اسم_مجلد)
      خزق_عدد = خزق_عدد + ١
      إذا خزق_حجم["نجاح"]:
        خزق_حرر = خزق_حرر + خزق_حجم["حجم"]
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر جمع قمامة: " + خزق_مجلد}
  ارجع {"نجاح": صحيح، "حذف": خزق_عدد، "حرر": خزق_حرر}

دالة اجمع_القمامة_مع_الأجيال(خزجق_أساس):
  خزجق_حالي = ٠
  خزجق_مسار_حالي = خزجق_أساس + "/حزم/أجيال/حالي"
  إذا خزجق_أساس == "":
    خزجق_مسار_حالي = "حزم/أجيال/حالي"
  إذا موجود(خزجق_مسار_حالي):
    حاول:
      خزجق_حالي = عدد(اقرأ_ملف(خزجق_مسار_حالي).قص())
    ماعدا:
      خزجق_حالي = ٠
  خزجق_قديمة = ٠
  خزجق_مجلد_قديمة = خزجق_أساس + "/حزم/أجيال-قديمة"
  إذا خزجق_أساس == "":
    خزجق_مجلد_قديمة = "حزم/أجيال-قديمة"
  حاول:
    خزجق_خام = اعرض_الشجرة()
  ماعدا:
    خزجق_خام = []
  خزجق_مجلد_أجيال = خزجق_أساس + "/حزم/أجيال"
  إذا خزجق_أساس == "":
    خزجق_مجلد_أجيال = "حزم/أجيال"
  لكل خزجق_سطر في خزجق_خام:
    خزجق_مسار = خزجق_سطر.قص()
    إذا نصوص.يبدأ_ب(خزجق_مسار، خزجق_مجلد_أجيال + "/") == خطأ:
      تابع
    خزجق_باقي = نصوص.من_الفهرس(خزجق_مسار، طول(خزجق_مجلد_أجيال) + ١)
    إذا خزجق_باقي.يحتوي("/"):
      تابع
    إذا إصدار.كلها_أرقام(خزجق_باقي) == خطأ:
      تابع
    إذا عدد(خزجق_باقي) == خزجق_حالي:
      تابع
    إذا موجود(خزجق_مجلد_قديمة) == خطأ:
      حاول:
        أنشئ_مجلد(خزجق_مجلد_قديمة)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد الأجيال القديمة"}
    حاول:
      انقل(خزجق_مجلد_أجيال + "/" + خزجق_باقي، خزجق_مجلد_قديمة + "/" + خزجق_باقي)
      خزجق_قديمة = خزجق_قديمة + ١
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر نقل الجيل القديم: " + خزجق_باقي}
  خزجق_قمامة = اجمع_القمامة(خزجق_أساس)
  إذا خزجق_قمامة["نجاح"] == خطأ:
    ارجع خزجق_قمامة
  ارجع {"نجاح": صحيح، "أجيال": خزجق_قديمة، "حذف": خزجق_قمامة["حذف"]، "حرر": خزجق_قمامة["حرر"]}

دالة حجم_الإغلاق(خزغ_اسم، خزغ_فهرس):
  خزغ_طابور = [خزغ_اسم]
  خزغ_رأيتها = []
  خزغ_فهرس_عد = ٠
  بينما خزغ_فهرس_عد < طول(خزغ_طابور):
    خزغ_اسم_حالي = خزغ_طابور[خزغ_فهرس_عد]
    خزغ_فهرس_عد = خزغ_فهرس_عد + ١
    إذا خزغ_اسم_حالي في خزغ_رأيتها:
      تابع
    خزغ_رأيتها.أضف(خزغ_اسم_حالي)
    لكل خزغ_إدخال في خزغ_فهرس:
      إذا خزغ_إدخال["اسم"] == خزغ_اسم_حالي:
        لكل خزغ_اعتماد في خزغ_إدخال["اعتماديات"]:
          خزغ_طابور.أضف(خزغ_اعتماد["اسم"])
  خزغ_حجم = ٠
  لكل خزغ_اسم_ثان في خزغ_رأيتها:
    لكل خزغ_إدخال_ثان في خزغ_فهرس:
      إذا خزغ_إدخال_ثان["اسم"] == خزغ_اسم_ثان:
        خزغ_حجم = خزغ_حجم + خزغ_إدخال_ثان["حجم"]
        اكسر
  ارجع {"نجاح": صحيح، "حجم": خزغ_حجم، "حزم": طول(خزغ_رأيتها)}

دالة معلومات_ملف(خزع_مسار):
  إذا موجود(خزع_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "ملف الحزمة غير موجود: " + خزع_مسار}
  حاول:
    خزع_نص = اقرأ_ملف(خزع_مسار)
    خزع_بصمة = تشفير.جزّئ(خزع_نص)
    خزع_حجم = حجم_المسار(خزع_مسار)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة ملف الحزمة: " + خزع_مسار}
  خزع_رأس = ""
  خزع_رأى_ملفات = خطأ
  لكل خزع_سطر في خزع_نص.قسم("\n"):
    إذا خزع_سطر.قص() == "ملفات:":
      خزع_رأى_ملفات = صحيح
      تابع
    إذا خزع_رأى_ملفات == خطأ:
      خزع_رأس = خزع_رأس + خزع_سطر + "\n"
  خزع_بيان = بيان.حلّل_بيان(خزع_رأس)
  إذا خزع_بيان["نجاح"] == خطأ:
    ارجع خزع_بيان
  ارجع {"نجاح": صحيح، "بيان": خزع_بيان["بيان"]، "حجم": خزع_حجم، "بصمة": خزع_بصمة}

دالة ملفات_من_ملف(خزم_مسار):
  إذا موجود(خزم_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "ملف الحزمة غير موجود: " + خزم_مسار}
  حاول:
    خزم_نص = اقرأ_ملف(خزم_مسار)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة ملف الحزمة: " + خزم_مسار}
  خزم_ملفات = []
  خزم_رأى = خطأ
  لكل خزم_سطر في خزم_نص.قسم("\n"):
    خزم_مقصوص = خزم_سطر.قص()
    إذا خزم_رأى == خطأ:
      إذا خزم_مقصوص == "ملفات:":
        خزم_رأى = صحيح
      تابع
    إذا خزم_مقصوص != "":
      خزم_ملفات.أضف(خزم_مقصوص)
  إذا خزم_رأى == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "ملف الحزمة بلا قائمة ملفات: " + خزم_مسار}
  ارجع {"نجاح": صحيح، "ملفات": خزم_ملفات}

# --- ضابطات الخيارات (§5 و§6 و§10) ---
دالة بتنظيف_تلقائي(خزت_خيارات، خزت_قيمة):
  ارجع خز_ضع_خيار(خزت_خيارات، "تنظيف_تلقائي"، خزت_قيمة)

دالة بجاهز(خزج_خيارات):
  ارجع خز_ضع_خيار(خزج_خيارات، "جاهز"، صحيح)

دالة بتنزيل_معزول(خزن_خيارات):
  ارجع خز_ضع_خيار(خزن_خيارات، "تنزيل_معزول"، صحيح)
