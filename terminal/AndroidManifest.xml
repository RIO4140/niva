<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rio4140.niva"
    android:versionCode="31"
    android:versionName="1.2.18">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- قفل الاستيقاظ أثناء الجلب (بند 11): إذن عادي، بلا حوار. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- فحص الاتصال قبل الجلب (بند 12): إذن عادي، بلا حوار. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- الخدمة الأمامية (بند 13). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- التحديث الذاتي (v1.1.4): إذن تثبيت تطبيقات غير
         معروفة — يُمنح من الإعدادات، لا من حوار؛ وبلا
         سماح لا تنزيل ولا تثبيت. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- الاهتزاز (v1.1.6 بند 26): إذن عادي، بلا حوار. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- إذن الإشعارات (المهمة 21 — جهاز.نبّه): إذن خطر
         وقت التشغيل في أندرويد 13+؛ يُطلب عند أول نبّه
         بلا إذن فقط، لا عند الفتح ولا عند بدء جلسة. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- إذن الميكروفون (المهمة 26 — جهاز.اسمع): إذن خطر
         وقت التشغيل؛ يُطلب عند أول اسمع بلا إذن فقط، بعد
         حوار إفصاح أن الصوت يذهب لخدمة تعرف صوتي خارجية. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- الكاميرا (الدفعة 4أ — جهاز.التقط_صورة؛ الدفعة
         4ب — جهاز.مصباح): إذن خطر وقت التشغيل؛ يُطلب
         عند أول التقاط أو مصباح بلا إذن فقط. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- الموقع الدقيق (الدفعة 4أ — جهاز.موقع وموقع_حي
         ومسح_واي_فاي): إذن خطر وقت التشغيل؛ يُطلب عند
         أول استعمال بلا إذن فقط. لمسح واي فاي هو إذن
         مسح لا تتبع. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- حالة واي فاي (الدفعة 4أ — جهاز.واي_فاي
         ومسح_واي_فاي): إذن عادي، بلا حوار. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- تعديل إعدادات الصوت (الدفعة 4ب —
         جهاز.اضبط_مستوى_الصوت): إذن عادي، يُمنح عند
         التثبيت. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- الكتابة في إعدادات النظام (الدفعة 4ب —
         جهاز.سطوع): إذن خاص؛ بلا منح يفتح التطبيق
         شاشة إعدادات النظام ويخبر المستخدم أن يعيد
         المحاولة بعد المنح. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- إدارة كل الملفات (الدفعة 5 — البندان 94 و96):
         إذن خاص؛ يُطلب عند أول «اكشف التخزين» فقط،
         من شاشة إعدادات النظام؛ وبلا منح يبقى
         تخزين/تنزيلات مغلقا، ولا يُطلب عند الفتح
         ولا عند بدء جلسة أبدا. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <application
        android:label="نيفا"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Black.NoTitleBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- استقبال ملفات .نيفا (المهمة 28 — CATALOG-19
                 §13): مشاركة نص وعرض ملف نصي — والفحص
                 (الامتداد .نيفا) في الكود لا هنا، فلا
                 ملف غير نيفا يُشغَّل أبدا. فلتر العرض
                 مقسوم: content بلا نمط مسار — مسارات
                 موفري المستندات معتمة فلا تحمل الاسم
                 (الفحص في الكود على اسم العرض + حوار
                 تأكيد)؛ وfile مقيد بنمط `.*[.]نيفا`
                 (المسار هنا يحمل الاسم الحقيقي). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*[.]نيفا" />
            </intent-filter>
            <!-- اختصارات المشغّل (v1.1.6 بند 2): «جلسة
                 جديدة» و«فتح الإعدادات» من الضغطة الطويلة
                 على الأيقونة؛ singleTask يمنع نسخة ثانية. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- الخدمة الأمامية (بند 13): إشعار الجلسات؛ لا
             تُصدَّر، ولا تستعيد الجلسات بعد موت العملية. -->
        <service
            android:name=".NivaService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
        <!-- مزوّد ملف التحديث (v1.1.4): يخدم ملف التثبيت
             المنزَّل للمثبّت فقط؛ لا يُصدَّر، ولا يخدم
             أي ملف آخر. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.rio4140.niva.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- مزوّد ملفات البرنامج (الدفعة 4أ — البنود 22
             و23 و32): يخدم ملفات مجلد البرنامج قراءة
             فقط لتطبيقات خارجية (مشاركة وفتح وكتابة
             صورة ملتقطة)، ويرفض niva.properties دائما؛
             لا يُصدَّر، ويعمل بمنح لمرة واحدة فقط. -->
        <provider
            android:name=".NivaFileProvider"
            android:authorities="com.rio4140.niva.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
